# Anthropic API キー（/api/parse のメール解析に使用。既定プロバイダ）
ANTHROPIC_API_KEY=

# 開発時の暫定検証用（任意）。openai を指定すると OPENAI_API_KEY を使う。
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1

# Google Maps Platform キー（任意）。Geocoding API・Directions API・Places API を有効化したものを指定する。
# 未設定でもアプリは動作する（ヒューリスティック推定・固定スポットにフォールバック）。
# 設定すると: 住所からの座標変換、地点間の実測移動時間、空き時間の周辺観光スポット提案が実データになる。
GOOGLE_MAPS_API_KEY=
